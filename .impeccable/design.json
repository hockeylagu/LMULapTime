  "components": [
    {
      "name": "Nav Tab Group",
      "kind": "nav",
      "refersTo": "nav-tab-active",
      "description": "Top-bar tab group; active tab solid Pit Lane Red.",
      "html": "<nav class=\"ds-nav\"><a class=\"ds-nav-tab ds-nav-tab--active\" href=\"#\">Dashboard</a><a class=\"ds-nav-tab\" href=\"#\">Tracks</a><a class=\"ds-nav-tab\" href=\"#\">Leaderboard</a></nav>",
      "css": ".ds-nav{display:inline-flex;gap:4px;padding:4px;background:#151A23;border:1px solid #232A36;border-radius:12px;font-family:'Segoe UI',sans-serif}.ds-nav-tab{padding:6px 14px;border-radius:8px;font-size:14px;font-weight:500;color:#8D99AE;text-decoration:none;transition:background .15s,color .15s}.ds-nav-tab:hover{color:#fff;background:rgba(35,42,54,.5)}.ds-nav-tab:focus-visible{outline:2px solid #DC3441;outline-offset:2px}.ds-nav-tab--active,.ds-nav-tab--active:hover{background:#DC3441;color:#fff}"
    },
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Main action; uppercase tracked label on red.",
      "html": "<button class=\"ds-btn-primary\">Build debrief</button>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;gap:8px;padding:10px 20px;border:none;border-radius:12px;background:#DC3441;color:#fff;font:700 12px 'Segoe UI',sans-serif;text-transform:uppercase;letter-spacing:.05em;cursor:pointer;transition:opacity .15s}.ds-btn-primary:hover{opacity:.9}.ds-btn-primary:focus-visible{outline:2px solid #DC3441;outline-offset:2px}.ds-btn-primary:disabled{opacity:.5;cursor:not-allowed}"
    },
    {
      "name": "Icon Button",
      "kind": "button",
      "refersTo": "button-icon",
      "description": "Square icon action in an inset well.",
      "html": "<button class=\"ds-btn-icon\" aria-label=\"Refresh\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8\"/><path d=\"M21 3v5h-5\"/><path d=\"M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16\"/><path d=\"M8 16H3v5\"/></svg></button>",
      "css": ".ds-btn-icon{display:inline-flex;align-items:center;justify-content:center;padding:6px;border-radius:8px;background:#0B0E14;border:1px solid #232A36;color:#8D99AE;cursor:pointer;transition:background .15s,color .15s}.ds-btn-icon:hover{background:#1A202C;color:#fff}.ds-btn-icon:focus-visible{outline:2px solid #DC3441;outline-offset:2px}"
    },
    {
      "name": "Segmented Pills",
      "kind": "chip",
      "refersTo": "segment-selected",
      "description": "Signature filter control: monospace uppercase segments in an inset well.",
      "html": "<div class=\"ds-seg\" role=\"group\"><button class=\"ds-seg-btn ds-seg-btn--on\">ALL</button><button class=\"ds-seg-btn\">Practice</button><button class=\"ds-seg-btn\">Qualifying</button><button class=\"ds-seg-btn\">Race</button></div>",
      "css": ".ds-seg{display:inline-flex;align-items:center;gap:6px;height:36px;padding:0 6px;background:#0B0E14;border:1px solid #232A36;border-radius:12px}.ds-seg-btn{height:24px;padding:0 14px;border-radius:5px;border:1px solid #1D293D;background:transparent;color:#7F8BA1;font:700 12px monospace;text-transform:uppercase;letter-spacing:.05em;cursor:pointer;transition:color .15s}.ds-seg-btn:hover{color:#fff;border-color:#314158}.ds-seg-btn:focus-visible{outline:2px solid #DC3441;outline-offset:2px}.ds-seg-btn--on,.ds-seg-btn--on:hover{background:#DC3441;border-color:#DC3441;color:#fff}"
    },
    {
      "name": "Status Pills",
      "kind": "chip",
      "refersTo": "status-pill",
      "description": "Tinted signal pills: pit stop, out lap, gain, loss.",
      "html": "<div class=\"ds-pills\"><span class=\"ds-pill ds-pill--pit\">PIT STOP</span><span class=\"ds-pill ds-pill--out\">Out Lap</span><span class=\"ds-pill ds-pill--gain\">-0.214</span><span class=\"ds-pill ds-pill--loss\">+0.387</span></div>",
      "css": ".ds-pills{display:flex;gap:8px}.ds-pill{display:inline-flex;align-items:center;padding:2px 8px;border-radius:4px;font:700 11px 'Segoe UI',sans-serif;letter-spacing:.03em;border:1px solid transparent}.ds-pill--pit{background:rgba(220,52,65,.2);color:#F26B74}.ds-pill--out{background:rgba(6,182,212,.15);border-color:rgba(6,182,212,.3);color:#00D3F2}.ds-pill--gain{font-family:monospace;background:rgba(52,211,153,.12);border-color:rgba(52,211,153,.3);color:#00D492}.ds-pill--loss{font-family:monospace;background:rgba(251,113,133,.12);border-color:rgba(251,113,133,.3);color:#FF637E}"
    },
    {
      "name": "Readout Panel",
      "kind": "card",
      "refersTo": "panel",
      "description": "Solid tonal panel with label-over-readout figures (the pit wall stack).",
      "html": "<section class=\"ds-panel\"><h3 class=\"ds-panel-title\">Daytona International Speedway</h3><div class=\"ds-stats\"><div><div class=\"ds-label\">Best lap</div><div class=\"ds-readout\">1:35.894</div></div><div><div class=\"ds-label\">True pace</div><div class=\"ds-readout\">1:36.210</div></div><div><div class=\"ds-label\">vs rival</div><div class=\"ds-readout ds-loss\">+0.312</div></div></div></section>",
      "css": ".ds-panel{background:#151A23;border:1px solid #232A36;border-radius:16px;padding:24px;font-family:'Segoe UI',sans-serif;color:#F8F9FA}.ds-panel-title{margin:0 0 16px;font-size:14px;font-weight:700}.ds-stats{display:flex;gap:32px}.ds-label{font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.05em;color:#8D99AE;margin-bottom:4px}.ds-readout{font:800 18px monospace;color:#fff}.ds-loss{color:#FF637E}"
    },
    {
