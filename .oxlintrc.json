{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "react", "import"],
  "categories": { "correctness": "error", "perf": "error" },
  "ignorePatterns": ["dist/**", "coverage/**", "public/track-outlines/**"],
  "rules": {
    "typescript/no-explicit-any": "error",
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-argument": "error",
    "typescript/no-unsafe-return": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/await-thenable": "error",
    "typescript/no-base-to-string": "error",
    "typescript/restrict-template-expressions": "error",
    "typescript/restrict-plus-operands": "error",
    "typescript/return-await": "error",
    "typescript/only-throw-error": "error",
    "typescript/prefer-promise-reject-errors": "error",
    "typescript/no-unsafe-enum-comparison": "error",
    "typescript/switch-exhaustiveness-check": "error",
    "import/no-cycle": "error",
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",
    "react/set-state-in-effect": "error",
    "react/refs": "error",
    "unicorn/no-new-array": "off", // Hot numeric code preallocates arrays by length (new Array<number>(n)); Array.from is slower.
    "oxc/no-map-spread": "off", // Per-item copies in map() are deliberate: rows stay immutable.
    "react/no-array-index-key": "off", // Index keys mark positions (gradient stops, ticks, fixed columns, report text); filtered lists key by data.
    "max-lines": ["error", { "max": 1000, "skipBlankLines": false, "skipComments": false }]
  },
  "overrides": [
    {
      "files": ["src/components/**/*.tsx"],
      "rules": { "max-lines": ["error", { "max": 300, "skipBlankLines": false, "skipComments": false }] }
    },
    {
      "files": ["server/**", "shared/**", "test/**"],
      "rules": { "import/extensions": ["error", "always", { "ignorePackages": true }] }
    },
    {
      "files": ["src/**"],
      "rules": {
        "no-restricted-globals": ["error", { "name": "fetch", "message": "Use fetchJson/postJson from src/api/apiClient.ts." }],
        "no-restricted-imports": ["error", { "patterns": [{ "group": ["**/server/**"], "message": "The frontend talks to the server only through /api." }] }]
      }
    },
    {
      "files": ["test/**"],
      "rules": {
        "react/globals": "off", // Test harnesses hand the router's navigate and similar handles out through module variables.
        "require-yield": "off", // Mock async iterators finish without yielding to simulate empty streams.
        "react/jsx-no-constructed-context-values": "off" // Wrapper providers take fresh values per render on purpose.
      }
    },
    {
      "files": ["test/**", "tools/**"],
      "rules": {
        "eslint/no-await-in-loop": "off" // Test setup and benchmark steps each depend on the one before.
      }
    },
    {
      "files": [
        "src/components/replay/inspector/useReplayInspectorData.ts",
        "src/components/replay/map/scene/GpsTrackSegments.tsx",
        "src/components/replay/map/useGpsMapPanZoom.ts",
        "src/components/replay/telemetry/useTelemetryStripInteraction.ts"
      ],
      "rules": {
        "react/refs": "off" // Playback, pan/zoom and scrub handlers read and update these refs mid-gesture, ahead of the next render.
      }
    },
    {
      "files": ["src/api/apiClient.ts"],
      "rules": {
        "no-restricted-globals": "off" // apiClient.ts is the one place that wraps fetch.
      }
    },
    {
      "files": ["shared/**"],
      "rules": {
        "no-restricted-imports": ["error", { "patterns": [{ "group": ["**/server/**", "**/src/**"], "message": "shared/ must not depend on server/ or src/." }] }]
      }
    }
  ]
}
