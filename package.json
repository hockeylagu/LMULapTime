{
  "name": "lmu-lap-time-analyzer",
  "version": "1.0.0",
  "description": "Comprehensive telemetry analytics, lap comparison, and benchmark progression analyzer for Le Mans Ultimate (LMU)",
  "author": "Samuel Lague",
  "license": "MPL-2.0",
  "keywords": [
    "le-mans-ultimate",
    "sim-racing",
    "telemetry",
    "lap-times",
    "motorsport",
    "rfactor2"
  ],
  "type": "module",
  "scripts": {
    "start": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node --env-file-if-exists=.env.local --import tsx --watch-path=server --watch-path=shared server/index.ts",
    "dev:client": "vite",
    "build": "npm run check:local-data && tsc && vite build && node tools/release/checkLocalData.mjs --built",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "telemetry:probe": "dotnet run -c Release --project tools/telemetry-recorder -- probe",
    "telemetry:record": "dotnet run -c Release --project tools/telemetry-recorder -- record",
    "vcr:correlate": "tsx tools/analysis/correlateVcr.ts",
    "screenshots": "tsx tools/captureScreenshots.ts",
    "check:local-data": "node tools/release/checkLocalData.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.26.0",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.6",
    "duckdb": "^1.4.4",
    "express": "^5.2.1",
    "fast-xml-parser": "^5.11.2",
    "lucide-react": "^1.50.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.3.1",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "concurrently": "^10.0.5",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.28",
    "supertest": "^7.3.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "tar": "^7.5.22"
  }
}
